# Generate 32 random bytes, encode as 64 hex characters. Never commit a real key.
CREDENTIAL_ENCRYPTION_KEY=
# Without test login mode, authenticated users can configure their own encrypted keys.
# Shared developer test mode. Set all login secrets together; never expose them to frontend bundles.
TEST_LOGIN_USERNAME=
TEST_LOGIN_PASSWORD=
TEST_SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Used by global learning agents in production; do not use a seller's key for global batches.
LEARNING_OPENAI_API_KEY=
LEARNING_OPENAI_MODEL=gpt-4.1-mini
GLOBAL_LEARNING_TRIGGER_COUNT=20
GLOBAL_AGENT_MIN_CONFIDENCE=0.7
GLOBAL_ROLLBACK_MIN_SAMPLE=10
GLOBAL_ROLLBACK_ADOPTION_THRESHOLD=0.2
PERSONAL_PROFILE_MIN_CONFIDENCE=0.7
PERSONAL_PROFILE_MAX_DIMENSION_CHANGES=2
LEARNING_WORKER_TOKEN=
# Demo mode runs one learning queue cycle before returning from save.
DEMO_INLINE_LEARNING=true
